---
import TimelineEntry from './TimelineEntry.astro'
import Footer from './Footer.astro'
import StandardEbooks from './StandardEbooks.astro';
import DifferentialCryptanalysis from './DifferentialCryptanalysis.astro';
import Daedalus from './Daedalus.astro';
import Ebukafy from './Ebukafy.astro';
---
<main class="lg:ml-115 lg:pt-22">
  <section class="lg:px-4 lg:mb-8 mt-2">
    <h3 class="block lg:hidden mb-4">PROJECTS</h3>
    <section id="differential-cryptanalysis">
      <DifferentialCryptanalysis />
    </section>
    <section id="standard-ebooks" class="lg:mt-24 lg:mb-8 mt-16">
      <StandardEbooks />
    </section>
    <section id="ebukafy" class="lg:mt-24 lg:mb-8 mt-16">
      <Ebukafy />
    </section>
    <section id="daedalus" class="lg:mt-24 lg:mb-8 mt-16">
      <Daedalus />
    </section>
  </section>
  <section id="resume" class="lg:px-4 lg:mt-24 lg:mb-8 mt-16">
    <h3 class="block lg:hidden mb-4">RESUME</h3>
    <TimelineEntry
      title="MSc in Computer Science"
      organization="University of California, Davis"
      startDate="Sep 2021"
      endDate="Dec 2022"
    />
    <TimelineEntry
      title="BS in Computer Science"
      organization="University of California, Santa Cruz"
      startDate="Sep 2017"
      endDate="Dec 2020"
    />
    <span class="flex justify-center text-2xl lg:my-0 my-6">⁂</span>
    <TimelineEntry
      title="Programmer Analyst"
      organization="Oregon Bankruptcy Court"
      startDate="Aug 2026"
      description="Promoted to administrator of courtroom technology, workstation software, and communication systems, with expanded programming duties. Removed 120 unused dead-code files from a decades-old, business-critical codebase, improving readability; documented the cleanup and archived the files for future reference."
      tags={["PowerShell", "CMD", "Perl"]}
    />
    <TimelineEntry
      title="Systems Analyst / Programmer"
      organization="Oregon Bankruptcy Court"
      startDate="Jul 2023"
      endDate="Aug 2026"
      description="Rewrote a search script for a mission-critical codebase, parallelizing grep with xargs to cut search time from 10 minutes to 2. Built an automated deployment process standardizing laptop configurations, cutting build time from 3 days to 8 hours. Created scripts automating developer application setup, ensuring consistency across machines."
      tags={["PowerShell", "CMD"]}
    />
    <TimelineEntry
      title="Software Developer"
      organization="Digital Copilot"
      startDate="Aug 2025"
      endDate="Jan 2026"
      description="Implemented an algorithm predicting aircraft takeoff and landing positions from ADS-B data, flagging collisions up to 90 seconds ahead; validated against real incidents. Built a Godot application visualizing predicted flight paths with collision warnings. Developed a Python pipeline to collect, interpolate, and standardize historical flight data."
      tags={["Godot", "Python"]}
    />
    <TimelineEntry
      title="Open Source Contributor"
      organization="Standard Ebooks"
      startDate="Feb 2020"
      endDate="Apr 2023"
      description="Produced 13 books for Standard Ebooks, a volunteer project creating free, open-source modern editions of public domain ebooks. Contributed Python code to its production tools. Promoted to reviewer after two years, checking other contributors’ books for typos and formatting issues before publication."
      tags={["Python", "EPUB", "Open Source", "Public Domain"]}
    />
    <TimelineEntry
      title="Software Engineer"
      organization="CloudMondo"
      startDate="Jun 2017"
      endDate="Jul 2017"
      description="Developed Android and iOS apps for access node provisioning, making GUI and functional changes that improved readability and reduced power consumption."
      tags={["Java", "Swift"]}
    />
    <h3 class="inline-block lg:ml-8 mt-8 transition-transform duration-110 ease-out hover:scale-108 hover:text-highlight">
      <a href="/resume.pdf" target="_blank">View full resume ↗</a>
    </h3>
  </section>
  <Footer />
</main>