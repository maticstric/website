---
import TimelineEntry from './TimelineEntry.astro'
import Footer from './Footer.astro'
---
<main class="lg:ml-115 lg:pt-24">
  <section id="about" class="space-y-4">
    <h3 class="block lg:hidden">ABOUT</h3>
    <p class="lg:px-4">I'm a software engineer who enjoys building clean, functional interfaces — the kind of thing that looks simple on the surface but has a surprising amount of thought behind the details. I care about writing code that's still easy to read six months later, which usually means more time spent naming things well than actually writing logic.</p>
    <p class="lg:px-4">Lately I've been exploring how far I can push a simple design system before it stops being simple, and I have a habit of turning "quick weekend projects" into small obsessions that take three weeks longer than planned.</p>
    <p class="lg:px-4">When I'm not at a keyboard, I'm probably applying that same instinct to some other hobby — figuring out the most needlessly precise way to do something that didn't need to be precise at all.</p>
  </section>
  <section id="education" class="lg:mt-28 lg:mb-8 mt-16">
    <h3 class="block lg:hidden">EDUCATION</h3>
    <TimelineEntry
      title="MSc in Computer Science"
      organization="University of California, Davis"
      startDate="Sep 2021"
      endDate="Dec 2022"
    />
    <TimelineEntry
      title="BS in Computer Science"
      organization="University of California, Santa Cruz"
      startDate="Sep 2017"
      endDate="Dec 2020"
    />
  </section>
  <span class="hidden lg:flex justify-center text-2xl">⁂</span>
  <section id="work" class="lg:my-8 mt-16">
    <h3 class="block lg:hidden">WORK</h3>
    <TimelineEntry
      title="Programmer Analyst"
      organization="Oregon Bankruptcy Court"
      startDate="Aug 2026"
      description="Maintain and automate the court's case management systems using PowerShell and Perl. Write CMD-based scripts for system administration and batch processing of filings. Work with clerks and IT staff to ensure secure, reliable handling of bankruptcy records."
      tags={["PowerShell", "CMD", "Perl"]}
    />
    <TimelineEntry
      title="Systems Analyst / Programmer"
      organization="Oregon Bankruptcy Court"
      startDate="Jul 2023"
      endDate="Aug 2026"
      description="Built PowerShell automation to reduce manual work in docketing and reporting. Maintained CMD scripts for backups and scheduled maintenance. Gathered requirements from court staff and provided tier-2 support for internal tools."
      tags={["PowerShell", "CMD"]}
    />
    <TimelineEntry
      title="Software Developer"
      organization="Digital Copilot"
      startDate="Aug 2025"
      endDate="Jan 2026"
      description="Developed an algorithm that predicts aircraft positions during takeoff and landing from historical ADS-B data, flagging potential collisions up to 90 seconds in advance and validated against several real-world incidents. Built the Python data pipeline and a Godot visualization tool to support testing and analysis."
      tags={["Godot", "Python"]}
    />
    <TimelineEntry
      title="Open Source Contributor"
      organization="Standard Ebooks"
      startDate="Feb 2020"
      endDate="Apr 2023"
      description="Produced 12 books for Standard Ebooks, a volunteer-run project publishing free, open source editions of public domain ebooks. Contributed Python code to its production tools and was promoted to reviewer after two years, checking other contributors' books for typos and formatting issues."
      tags={["Python", "EPUB", "Open Source", "Public Domain"]}
    />
    <TimelineEntry
      title="Software Engineer"
      organization="CloudMondo"
      startDate="Jun 2017"
      endDate="Jul 2017"
      description="Contributed to the Android and iOS apps used for access node provisioning, implementing GUI and functional improvements that enhanced usability, readability, and power efficiency. Also restructured the codebase to streamline Flurry integration for data analysis."
      tags={["Java", "Swift"]}
    />
  </section>
  <span class="hidden lg:flex justify-center text-2xl">⁂</span>
  <section id="projects" class="lg:my-8 mt-16">
    <h3 class="block lg:hidden">PROJECTS</h3>
    <TimelineEntry
      title="tag"
      startDate="Jul 2024"
      endDate="Aug 2024"
      description="A two player, local-multiplayer tag game made by me in three weeks for the Portland Indie Game Squad 2024 Summer Slow Jams."
      tags={["Godot", "Game Jam", "Game Development"]}
      link="https://maticstric.itch.io/tag"
    />
    <TimelineEntry
      title="Differential Cryptanalysis Tutorial"
      startDate="Sep 2021"
      endDate="Nov 2022"
      description="My Master's project. A tutorial on an advanced technique used to break symmetric key block ciphers. In contrast to other tutorials of the technique, it is interactive, uses simple language, avoids math notation, and is aimed at amateur cryptographers."
      tags={["Python", "C", "JavaScript", "HTML", "CSS", "Cryptography"]}
      link="https://maticstric.github.io/differential-cryptanalysis-tutorial/"
    />
    <TimelineEntry
      title="daedalus"
      startDate="Feb 2021"
      endDate="Apr 2021"
      description="A website built with React which showcases different algorithms for maze generation with adjustable maze size and ability to step and play through the generation. Includes Randomized Depth First Search, Randomized Kruskal’s Algorithm, Randomized Prim’s Algorithm, and Wilson’s Algorithm."
      tags={["React", "JavaScript"]}
      link="https://maticstric.github.io/daedalus/"
    />
    <TimelineEntry
      title="ebukafy"
      startDate="Jan 2021"
      endDate="Apr 2021"
      description="A collection of tools used to convert html or text files into EPUB ebooks with over 3000 downloads in npm."
      tags={["JavaScript", "EPUB", "Open Source"]}
      link="https://www.npmjs.com/package/ebukafy"
    />
  </section>
  <Footer />
</main>