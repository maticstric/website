---
import StandardEbooksLogo from '../assets/images/logos/DaedalusLogo.svg';
import ProjectHeader from './ProjectHeader.astro';
---
<div>
  <ProjectHeader title="daedalus" subtitle="Maze generation algorithms" logo={StandardEbooksLogo} custommargin="6px" />
  <p>
    A website built with React which showcases different algorithms for maze generation with adjustable maze size and ability to step and play through the generation.
    Includes Randomized Depth First Search, Randomized Kruskal’s Algorithm, Randomized Prim’s Algorithm, and Wilson’s Algorithm.
  </p>
</div>