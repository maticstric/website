---
import SidebarLink from './SidebarLink.astro';
import SocialIcons from './SocialIcons.astro'
---
<aside class="lg:fixed lg:h-screen lg:pt-24 pt-10 flex flex-col justify-between">
  <div>
    <h1 class="-ml-[2px]">Matic Likar</h1>
    <h2 class="lg:mb-16 mb-8">Programmer</h2>
    <ul class="hidden lg:block">
      <SidebarLink href="#about" text="ABOUT" />
      <SidebarLink href="#education" text="EDUCATION" />
      <SidebarLink href="#work" text="WORK" />
      <SidebarLink href="#projects" text="PROJECTS" />
      <SidebarLink href="#resume" text="RESUME" />
    </ul>
  </div>
  <div class="justify-end">
    <SocialIcons />
  </div>
</aside>
<script>
  const links = document.querySelectorAll('aside a[href^="#"]');
  const sections = document.querySelectorAll('section[id]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          links.forEach((link) => link.classList.remove('active'));
          const match = document.querySelector(`aside a[href="#${entry.target.id}"]`);
          match?.classList.add('active');
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  sections.forEach((section) => observer.observe(section));
</script>