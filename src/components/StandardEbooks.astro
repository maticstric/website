---
import StandardEbooksLogo from '../assets/images/logos/StandardEbooksLogo.svg';
import ProjectHeader from './ProjectHeader.astro';
import BookCover from './BookCover.astro';

import CoverAgathaChristie from '../assets/images/covers/cover-agatha-christie.svg';
import CoverErnestHemingway from '../assets/images/covers/cover-ernest-hemingway.svg';
import CoverFritzLeiber from '../assets/images/covers/cover-fritz-leiber.svg';
import CoverHPLovecraft from '../assets/images/covers/cover-h-p-lovecraft.svg';
import CoverHarrietEWilson from '../assets/images/covers/cover-harriet-e-wilson.svg';
import CoverMarkTwain from '../assets/images/covers/cover-mark-twain.svg';
import CoverPhillisWheatley from '../assets/images/covers/cover-phillis-wheatley.svg';
import CoverPoulAnderson from '../assets/images/covers/cover-poul-anderson.svg';
import CoverRALafferty from '../assets/images/covers/cover-r-a-lafferty.svg';
import CoverRayBradbury from '../assets/images/covers/cover-ray-bradbury.svg';
import CoverRobertSheckley from '../assets/images/covers/cover-robert-sheckley.svg';
import CoverWilliamFaulkner from '../assets/images/covers/cover-william-faulkner.svg';
import CoverWilliamShakespeare from '../assets/images/covers/cover-william-shakespeare.svg';
---
<div>
  <ProjectHeader title="Standard Ebooks" subtitle="Producing public-domain ebooks" logo={StandardEbooksLogo} custommargin="3px" link="https://standardebooks.org/" tags={["Python", "EPUB", "Open Source", "Public Domain"]} />
  <p>
    Standard Ebooks is a volunteer-run project that produces free, open-source editions of public domain ebooks.
    It’s an organization close to my heart that brings together two of my passions: open-source software and reading, especially the classics that have entered the public domain.
    Each book follows a rigorous, modern style manual, which ensures a consistent, professional-grade typographic standard.
  </p>
  <p>
    At the heart of the process is a command-line tool that automates many of the routine steps.
    In addition to producing books, I’ve contributed to this software, helping make the process smooth for contributors without a technical background.
  </p>
  <p>
    After producing a few books, I was promoted to reviewer, a role that involves guiding new contributors through their first productions and signing off on their work before it moves on for final inspection.
  </p>
  <div id="covers" class="mt-10 grid gap-8 grid-cols-[repeat(auto-fit,minmax(min(150px,calc((100%-2rem)/2)),1fr))]">
    <BookCover cover={CoverAgathaChristie} link="https://standardebooks.org/ebooks/agatha-christie/poirot-investigates" alt="Agatha Christie book cover" />
    <BookCover cover={CoverRobertSheckley} link="https://standardebooks.org/ebooks/robert-sheckley/short-fiction" alt="Robert Sheckley book cover" />
    <BookCover cover={CoverErnestHemingway} link="https://standardebooks.org/ebooks/ernest-hemingway/short-fiction" alt="Ernest Hemingway book cover" />
    <BookCover cover={CoverPhillisWheatley} link="https://standardebooks.org/ebooks/phillis-wheatley/poems-on-various-subjects-religious-and-moral" alt="Phillis Wheatley book cover" />
    <BookCover cover={CoverWilliamShakespeare} link="https://standardebooks.org/ebooks/william-shakespeare/the-tempest" alt="William Shakespeare book cover" />
    <BookCover cover={CoverRayBradbury} link="https://standardebooks.org/ebooks/ray-bradbury/short-fiction" alt="Ray Bradbury book cover" />
    <BookCover cover={CoverFritzLeiber} link="https://standardebooks.org/ebooks/fritz-leiber/short-fiction" alt="Fritz Leiber book cover" />
    <BookCover cover={CoverHPLovecraft} link="https://standardebooks.org/ebooks/h-p-lovecraft/short-fiction" alt="H.P. Lovecraft book cover" />
    <BookCover cover={CoverHarrietEWilson} link="https://standardebooks.org/ebooks/harriet-e-wilson/our-nig" alt="Harriet E. Wilson book cover" />
    <BookCover cover={CoverMarkTwain} link="https://standardebooks.org/ebooks/mark-twain/roughing-it" alt="Mark Twain book cover" />
    <BookCover cover={CoverPoulAnderson} link="https://standardebooks.org/ebooks/poul-anderson/short-fiction" alt="Poul Anderson book cover" />
    <BookCover cover={CoverRALafferty} link="https://standardebooks.org/ebooks/r-a-lafferty/short-fiction" alt="R. A. Lafferty book cover" />
    <BookCover cover={CoverWilliamFaulkner} link="https://standardebooks.org/ebooks/william-faulkner/soldiers-pay" alt="William Faulkner book cover" />
  </div>
  <h3>
    <button id="view-all-button" class="mt-6 cursor-pointer transition-transform duration-110 ease-out hover:scale-108">View all ↙</button>
  </h3>
</div>

<script>
const VISIBLE_ROWS = 2
const VIEW_ALL_TEXT = "View all ↙"
const SHOW_LESS_TEXT = "Show less ↗"

const view_all_button = document.getElementById('view-all-button')!
const covers = document.getElementById('covers')!

window.addEventListener('resize', update_cover_visibility)
view_all_button?.addEventListener('click', toggle_extra_cover_visibility)

update_cover_visibility()

function update_cover_visibility() {
  const show_all = view_all_button?.textContent === SHOW_LESS_TEXT

  Array.from(covers.children).forEach((cover, i) => {
    cover.classList.toggle('hidden', !show_all && i >= column_count() * VISIBLE_ROWS)
  })
}

function toggle_extra_cover_visibility() {
  view_all_button.textContent = view_all_button.textContent === VIEW_ALL_TEXT ? SHOW_LESS_TEXT : VIEW_ALL_TEXT

  update_cover_visibility()
}

function column_count(): number {
  if (!covers) return 1

  return getComputedStyle(covers).gridTemplateColumns.split(' ').length
}
</script>