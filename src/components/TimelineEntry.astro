---
interface Props {
  title: string;
  organization?: string;
  startDate?: string;
  endDate?: string;
  description?: string;
  tags?: string[];
  link?: string;
}

const { title, organization, startDate, endDate = "Present", description, tags = [], link } = Astro.props;

const TopTag = link ? "a" : "div";
---

<TopTag href={link} target="_blank" class={`flex lg:px-8 lg:py-4 lg:my-2 my-4 ${link ? "lg:hover:bg-gray-300" : ""}`}>
  <div class="hidden lg:block lg:flex-none lg:w-45">
    <span class="text-sm">{startDate} – {endDate}</span>
  </div>
  <div>
    <h3>{title}</h3>
    <span class="block lg:hidden">{startDate} – {endDate}</span>
    <p class={description ? "mb-4" : ""}>{organization}</p>
    {description && (
      <p class="mb-4">{description}</p>
    )}
    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="text-xs font-mono px-2 py-1 border border-gray-300 rounded">{tag}</span>
        ))}
      </div>
    )}
  </div>
</TopTag>