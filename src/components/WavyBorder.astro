---
import { multipleOf } from 'astro:schema';

interface Props {
  amplitude?: number;
  wavelength?: number;
  stroke_width?: number;
}

const {
  amplitude = 4,
  wavelength = 80,
  stroke_width = 1
} = Astro.props;

const placeTop = (a: number, b: number) => `${a} ${b}`;

function get_wavy_square_svg(amplitude: number, wavelength: number, stroke_width: number) {
  const number_of_halfwaves = 5;
  const inset = (2 * wavelength) / (3 * Math.PI);
  const side_length = (wavelength / 2) * number_of_halfwaves;

  let d = 'M 0 0';
  let h = -(4 * amplitude) / 3;

  for (let i = 0; i < number_of_halfwaves; i++) {
    let start = (wavelength / 2 * i);
    let c1x = inset + start;
    let c2x = (wavelength / 2) - inset + start;

    let h_sign = i % 2 === 0 ? 1 : -1;

    d += ` C ${c1x} ${h * h_sign} ${c2x} ${h * h_sign} ${start + wavelength / 2} 0`;
  }

  for (let i = 0; i < number_of_halfwaves; i++) {
    let start = (wavelength / 2 * i);
    let c1y = inset + start;
    let c2y = (wavelength / 2) - inset + start;

    let h_sign = i % 2 === 0 ? -1 : 1;

    d += ` C ${side_length + h * h_sign} ${c1y} ${side_length + h * h_sign} ${c2y} ${side_length} ${start + wavelength / 2}`;
  }

  const vbX = -(stroke_width / 2);
  const vbY = -amplitude - (stroke_width / 2);
  const vbW = (wavelength / 2) * (number_of_halfwaves + 1) + stroke_width;
  const vbH = (wavelength / 2) * number_of_halfwaves + stroke_width;

  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${vbX} ${vbY} ${vbW} ${vbH}" width="400">
            <path d="${d}" fill="none" stroke="black" stroke-width="${stroke_width}" />
          </svg>`;
}

const svg = get_wavy_square_svg(amplitude, wavelength, stroke_width)
---

<Fragment set:html={svg} />