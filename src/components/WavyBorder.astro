---
interface Props {
  amplitude?: number;
  wavelength?: number;
  stroke_width?: number;
}

const {
  amplitude = 8,
  wavelength = 40,
  stroke_width = 1
} = Astro.props;

function get_halfwave_svg(amplitude: number, wavelength: number, stroke_width: number) {
  // Equations for two controlpoints generated by Claude
  const c1x = (2 * wavelength) / (3 * Math.PI);
  const c2x = (wavelength / 2) - (2 * wavelength) / (3 * Math.PI);
  const c3x = (2 * wavelength) / (3 * Math.PI) + wavelength / 2;
  const c4x = (wavelength / 2) - (2 * wavelength) / (3 * Math.PI) + wavelength / 2;

  // y is the same for both control points
  const y = -(4 * amplitude) / 3;

  const d = `M 0 0 C ${c1x} ${y} ${c2x} ${y} ${wavelength / 2} 0 C ${c3x} ${-y} ${c4x} ${-y} ${wavelength} 0`;

  const vbX = -(stroke_width / 2);
  const vbY = -amplitude - (stroke_width / 2);
  const vbW = wavelength + stroke_width;
  const vbH = amplitude * 2 + stroke_width;


  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${vbX} ${vbY} ${vbW} ${vbH}" width="400">
            <path d="${d}" fill="none" stroke="black" stroke-width="${stroke_width}" />
          </svg>`;
}

const svg = get_halfwave_svg(amplitude, wavelength, stroke_width)
---

<Fragment set:html={svg} />